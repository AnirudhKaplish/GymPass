# Server Configuration
PORT=8080
DEV_MODE=true

# Security Settings
JWT_SECRET=your_jwt_secret_key_here
OTP_EXPIRY=300
QR_REFRESH_SECONDS=60

# Database Configuration (SQLite or PostgreSQL)
DB_DRIVER=sqlite
DB_PATH=database/gympass.db
DATABASE_URL=host=localhost port=5432 user=your_db_user password=your_db_password dbname=your_db_name sslmode=disable

# Payment Processor Credentials (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Default Initial Administrator Setup
ADMIN_EMAIL=admin@gympass.com
ADMIN_PASSWORD=admin123
ADMIN_PHONE=9876543210

# Firebase Auth Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id_here
ADMIN_PHONES="+919876543210,+919999999999"
