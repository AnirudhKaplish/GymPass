# Server Configuration
PORT=8080
# DEV_MODE=true accepts any 6-digit OTP, skips real Razorpay calls and seeds demo data.
# Never run production with DEV_MODE=true.
DEV_MODE=true

# Security Settings
JWT_SECRET=your_jwt_secret_key_here
OTP_EXPIRY=300
QR_REFRESH_SECONDS=60

# Database Configuration (SQLite or PostgreSQL)
DB_DRIVER=sqlite
DB_PATH=database/gympass.db
DATABASE_URL=host=localhost port=5432 user=your_db_user password=your_db_password dbname=your_db_name sslmode=disable

# Payment Processor Credentials (Razorpay). UPI apps such as Google Pay and Paytm
# appear inside Razorpay's checkout once real keys are set.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Firebase Auth Configuration (member phone login)
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# Gym photos are stored in this folder and served from /uploads
UPLOAD_DIR=uploads

# A visit that is never punched out is closed automatically after this many hours
MAX_SESSION_HOURS=6

# Demo owner + two gyms (owner@gympass.com / owner12345). Defaults to on in DEV_MODE.
SEED_DEMO_DATA=true
